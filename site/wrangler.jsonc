// The site is static files with no Worker script. See README.md.
{
  "name": "roga-site",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "roga.sh", "custom_domain": true }],
  // Pull requests get a public preview on workers.dev, and the live site is only
  // at roga.sh.
  "workers_dev": false,
  "preview_urls": true
}
